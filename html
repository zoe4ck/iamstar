/* =========================================================
   기계용 카드 렌더링
========================================================= */

function renderMachineCards() {

    const list =
        document.getElementById(
            "machineCardList"
        );


    list.innerHTML =
        "";


    selectedCards.forEach(
        card => {

            const element =
                document.createElement(
                    "div"
