function renderCards(
    category = "all"
) {

    cardGrid.innerHTML =
        "";


    const filteredCards =
        category === "all"
            ? cards
            : cards.filter(
                card =>
                    card.category === category
            );


    filteredCards.forEach(
        card => {

            const element =
                document.createElement(
                    "div"
                );


            element.className =
                "fashion-card";


            if (
                selectedCards.some(
                    item =>
                        item.id === card.id
                )
            ) {

                element.classList.add(
                    "selected"
                );

