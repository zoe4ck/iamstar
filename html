}


/* =========================================================
   카드 선택
========================================================= */

function selectCard(card) {

    const exists =
        selectedCards.some(
            item =>
                item.id === card.id
        );


    if (exists) {

        selectedCards =
            selectedCards.filter(
                item =>
                    item.id !== card.id
            );

    } else {

        selectedCards.push(
            card
        );

    }


    const activeTab =
        document.querySelector(
            ".card-tab.active"
        );


    renderCards(
        activeTab
