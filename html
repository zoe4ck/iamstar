                        class="
                            card-clothing
                            ${card.art}
                        "
                    ></div>

                </div>

                ${card.name}

            `;


            element.addEventListener(
                "pointerdown",
                startCardDrag
            );


            list.appendChild(
                element
            );

        }
    );

}


/* =========================================================
   터치 드래그 변수
========================================================= */

let draggedCard = null;

let dragClone = null;

let dragOffsetX = 0;

let dragOffsetY = 0;


/* =========================================================
   카드 드래그 시작
========================================================= */

function startCardDrag(
    event
) {

    const element =
        event.currentTarget;


    const cardId =
        Number(
            element.dataset.id
        );


    const card =
        selectedCards.find(
            item =>
                item.id === cardId
        );


    if (!card) {

        return;

    }


    if (
        insertedCards[
            card.category
        ]
    ) {

        return;

    }


    draggedCard =
        card;


    const rect =
        element.getBoundingClientRect();


    dragOffsetX =
        event.clientX -
        rect.left;


    dragOffsetY =
        event.clientY -
        rect.top;


    dragClone =
        element.cloneNode(
            true
        );


    dragClone.style.position =
        "fixed";


    dragClone.style.left =
        `${
            event.clientX -
            dragOffsetX
        }px`;


    dragClone.style.top =
        `${
            event.clientY -
            dragOffsetY
        }px`;


    dragClone.style.width =
        `${rect.width}px`;


    dragClone.style.zIndex =
        "9999";


    dragClone.style.pointerEvents =
        "none";


    dragClone.style.transform =
        "scale(1.08) rotate(4deg)";


    document.body.appendChild(
        dragClone
    );


    element.style.opacity =
        ".35";


    document.addEventListener(
        "pointermove",
        moveCardDrag
    );


    document.addEventListener(
        "pointerup",
        endCardDrag,
        {
            once: true
        }
    );


    event.preventDefault();

}


/* =========================================================
   카드 이동
========================================================= */

function moveCardDrag(
    event
) {

    if (
        !dragClone
    ) {

        return;

    }


    dragClone.style.left =
        `${
            event.clientX -
            dragOffsetX
        }px`;


    dragClone.style.top =
        `${
            event.clientY -
            dragOffsetY
        }px`;


    const slot =
        document.getElementById(
            "cardSlot"
        );


    const rect =
        slot.getBoundingClientRect();


    const inside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;


    if (inside) {

        slot.classList.add(
            "drag-over"
        );

    } else {

        slot.classList.remove(
            "drag-over"
        );

    }

}


/* =========================================================
   카드 드래그 종료
========================================================= */

function endCardDrag(
    event
) {

    document.removeEventListener(
        "pointermove",
        moveCardDrag
    );


    const slot =
        document.getElementById(
            "cardSlot"
        );


    slot.classList.remove(
        "drag-over"
    );


    if (!draggedCard) {

        cleanupDrag();

        return;

    }


    const rect =
        slot.getBoundingClientRect();


    const inside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;


    if (inside) {

        insertCard(
            draggedCard
        );

    }


    cleanupDrag();

}


/* =========================================================
   드래그 정리
========================================================= */

function cleanupDrag() {

    if (
        dragClone
    ) {

        dragClone.remove();

    }


    if (
        draggedCard
    ) {

        const original =
            document.querySelector(
                `.machine-card[data-id="${draggedCard.id}"]`
            );


        if (original) {

            original.style.opacity =
                insertedCards[
                    draggedCard.category
                ]
                    ? ".3"
                    : "1";

        }

    }


    draggedCard =
        null;


    dragClone =
        null;

}


/* =========================================================
   카드 투입
========================================================= */

function insertCard(
    card
) {

    if (
        insertedCards[
            card.category
        ]
    ) {

        return;

    }


    insertedCards[
        card.category
    ] = card;


    const slot =
        document.getElementById(
            "slot-" +
            card.category
        );


    if (!slot) {

        return;

    }


    slot.classList.add(
        "filled"
    );


    slot.innerHTML = `

        <div
            class="slot-label"
        >
            ${card.type}
        </div>

        <div
            class="slot-card"
        >
            ${card.name}
        </div>

    `;


    const original =
        document.querySelector(
            `.machine-card[data-id="${card.id}"]`
        );


    if (original) {

        original.classList.add(
            "used"
        );

    }


    const machineSlot =
        document.getElementById(
            "cardSlot"
        );


    machineSlot.innerHTML = `
        ✦ ${card.name} 투입 완료! ✦
    `;


    checkTransformReady();

}


/* =========================================================
   기계 초기화
========================================================= */

function resetMachineSlots() {

    const categories = [

        "top",

        "skirt",

        "shoe",

        "accessory"

    ];


    categories.forEach(
        category => {

            const slot =
                document.getElementById(
                    "slot-" +
                    category
                );


            slot.classList.remove(
                "filled"
            );


            const label =
                category === "top"
                    ? "TOP"
                    : category === "skirt"
                    ? "BOTTOM"
                    : category === "shoe"
                    ? "SHOES"
                    : "ACCESSORY";


            slot.innerHTML = `

                <div
                    class="slot-label"
                >
                    ${label}
                </div>

                미투입

            `;

        }
    );


    document.getElementById(
        "cardSlot"
    ).innerHTML =
        "카드를 이곳으로 끌어주세요 ✦";


    document.getElementById(
        "transformButton"
    ).classList.remove(
        "ready"
    );

}


/* =========================================================
   변신 가능 여부
========================================================= */

function checkTransformReady() {

    const transformButton =
        document.getElementById(
            "transformButton"
        );


    const ready =

        insertedCards.top &&

        insertedCards.skirt &&

        insertedCards.shoe;


    if (ready) {

        transformButton.classList.add(
            "ready"
        );

    } else {

        transformButton.classList.remove(
            "ready"
        );

    }

}


/* =========================================================
   변신 시작
========================================================= */

function startTransformation() {

    if (

        !insertedCards.top ||

        !insertedCards.skirt ||

        !insertedCards.shoe

    ) {

        alert(
            "TOP, BOTTOM, SHOES 카드를 먼저 넣어주세요! ✨"
        );

        return;

    }


    showScreen(
        "transform"
    );


    setTimeout(
        () => {

            applyOutfitToResult();


            showScreen(
                "result"
            );

        },
        2600
    );

}


/* =========================================================
   결과 캐릭터 적용
========================================================= */

function applyOutfitToResult() {

    const resultCharacter =
        document.getElementById(
            "resultCharacter"
        );


    const resultMouth =
        document.getElementById(
            "resultMouth"
        );


    /* 캐릭터 */

    resultCharacter.style.setProperty(
        "--skin",
        characterState.skin
    );


    resultCharacter.style.setProperty(
        "--eye-color",
        characterState.eyeColor
    );


    resultCharacter.style.setProperty(
        "--hair",
        characterState.hairColor
    );


    resultCharacter.classList.remove(

        "eyes-round",

        "eyes-slim",

        "eyes-droopy",

        "eyes-sharp",

        "eyes-happy"

    );


    resultCharacter.classList.add(
        characterState.eyes
    );


    resultCharacter.classList.remove(

        "hair-long",

        "hair-bob",

        "hair-wave",

        "hair-ponytail",

        "hair-twin"

    );


    resultCharacter.classList.add(
        characterState.hair
    );


    resultMouth.className =
        "mouth " +
        characterState.mouth;


    /* =====================================================
       의상
    ===================================================== */

    const top =
        insertedCards.top;


    const skirt =
        insertedCards.skirt;


    const shoe =
        insertedCards.shoe;


    const accessory =
        insertedCards.accessory;


    const body =
        resultCharacter.querySelector(
            ".character-body"
        );


    const resultSkirt =
        resultCharacter.querySelector(
            ".character-skirt"
        );


    const shoes =
        resultCharacter.querySelectorAll(
            ".character-shoe"
        );


    /* TOP */

    if (top) {

        if (
            top.id === 1
        ) {

            body.style.background =
                "linear-gradient(135deg,#ff9fcf,#df6faf)";

        }


        if (
            top.id === 2
        ) {

            body.style.background =
                "linear-gradient(135deg,#fff,#f0d9e9)";

        }


        if (
            top.id === 3
        ) {

            body.style.background =
                "linear-gradient(135deg,#8ebbe8,#547bc4)";

        }

    }


    /* BOTTOM */

    if (skirt) {

        if (
            skirt.id === 4
        ) {

            resultSkirt.style.background =
                "linear-gradient(135deg,#f7a9d0,#c879ba)";

        }


        if (
            skirt.id === 5
        ) {

            resultSkirt.style.background =
                "linear-gradient(135deg,#fff,#e9d9e7)";

        }


        if (
            skirt.id === 6
        ) {

            resultSkirt.style.background =
                "linear-gradient(135deg,#8ebbe8,#547bc4)";

        }

    }


    /* SHOES */

    if (shoe) {

        if (
            shoe.id === 7
        ) {

            shoes.forEach(
                item => {

                    item.style.background =
                        "#e684b8";

                }
            );

        }


        if (
            shoe.id === 8
        ) {

            shoes.forEach(
                item => {

                    item.style.background =
                        "#f0b94d";

                }
            );

        }


        if (
            shoe.id === 9
        ) {

            shoes.forEach(
                item => {

                    item.style.background =
                        "#f5f1f4";

                }
            );

        }

    }


    /* =====================================================
       액세서리
    ===================================================== */

    const oldAccessory =
        resultCharacter.querySelector(
            ".result-accessory"
        );


    if (
        oldAccessory
    ) {

        oldAccessory.remove();

    }


    if (
        accessory
    ) {

        const decoration =
            document.createElement(
                "div"
            );


        decoration.className =
            "result-accessory";


        decoration.textContent =

            accessory.id === 11
                ? "♛"

                : accessory.id === 12
                ? "♡"

                : "🎀";


        resultCharacter.appendChild(
            decoration
        );

    }


    /* =====================================================
       결과 설명
    ===================================================== */

    const names =
        Object
            .values(
                insertedCards
            )
            .map(
                card =>
                    card.name
            )
            .join(
                " · "
            );


    document.getElementById(
        "resultInfo"
    ).textContent =
        names;

}


/* =========================================================
   초기 실행
========================================================= */

renderCards();

updateSelectedSummary();

updateCharacter();

</script>


