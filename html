        0 0 30px #e777b7,
        4px 4px 0 #c96ba8;

    animation:
        transformWord
        2.5s ease forwards;
}

@keyframes transformWord {

    0% {

        opacity: 0;

        transform:
            scale(.2)
            rotate(-15deg);
    }

    35% {

        opacity: 1;

        transform:
            scale(1.15)
            rotate(5deg);
    }

    70% {

        transform:
            scale(.95)
            rotate(-2deg);
    }

    100% {

        transform:
            scale(1)
            rotate(0);
    }

}

.magic-circle {

    position: absolute;

    width: 500px;

    height: 500px;

    left: 50%;

    top: 50%;

    transform:
