<!DOCTYPE html>
<html lang="ko">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>MY IDOL CARD</title>


<style>

/* =========================================================
   기본 설정
========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html,
body {
    width: 100%;
    min-height: 100%;
}

body {

    font-family:
        Arial,
        "Noto Sans KR",
        sans-serif;

    background:
        radial-gradient(
            circle at 50% 30%,
            #fff,
            #fff4fb 45%,
            #f7e5f3 100%
        );

    color: #5d4260;

    overflow-x: hidden;
}

button {

    font-family: inherit;

    cursor: pointer;

    border: none;

    -webkit-tap-highlight-color: transparent;
}


/* =========================================================
   화면
========================================================= */

.screen {

    display: none;

    width: 100%;

    min-height: 100vh;

    position: relative;

    overflow: hidden;
}

.screen.active {

    display: flex;
}


/* =========================================================
   배경 반짝이
========================================================= */

.sparkle {

    position: absolute;

    color: white;

    text-shadow:
        0 0 8px #fff,
        0 0 15px #ff9edb;

    animation:
        sparkleFloat 3s infinite ease-in-out;

    pointer-events: none;
}

.sparkle.s1 {

    top: 12%;
    left: 10%;

    font-size: 24px;
}

.sparkle.s2 {

    top: 25%;
    right: 12%;

    font-size: 17px;

    animation-delay: .8s;
}

.sparkle.s3 {

    bottom: 20%;
    left: 15%;

    font-size: 20px;

    animation-delay: 1.5s;
}

.sparkle.s4 {

    bottom: 15%;
    right: 20%;

    font-size: 28px;

    animation-delay: .4s;
}

@keyframes sparkleFloat {

    0%,
    100% {

        transform:
            translateY(0)
            scale(1);

        opacity: .6;
    }

    50% {

        transform:
            translateY(-12px)
            scale(1.2);

        opacity: 1;
    }

}


/* =========================================================
   1. OPENING
========================================================= */

#opening {

    align-items: center;

    justify-content: center;

    background:
        radial-gradient(
            circle at 50% 35%,
            #ffffff 0%,
            #fff7fc 30%,
            #f7d9ed 100%
        );
}

.opening-content {

    width: min(90%, 600px);

    text-align: center;

    position: relative;

    z-index: 2;

    animation:
        openingAppear 1.2s ease;
}

@keyframes openingAppear {

    from {

        opacity: 0;

        transform:
            translateY(20px)
            scale(.96);
    }

    to {

        opacity: 1;

        transform:
            translateY(0)
            scale(1);
    }

}

.logo-small {

    font-size: 14px;

    letter-spacing: 7px;

    color: #c58bb9;

    margin-bottom: 14px;
}

.main-logo {

    font-size:
        clamp(
            55px,
            13vw,
            100px
        );

    font-weight: 900;

    font-style: italic;

    letter-spacing: -6px;

    color: #f08bc6;

    text-shadow:
        3px 3px 0 white,
        6px 6px 0 #e5a1cf,
        0 0 20px rgba(
            255,
            140,
            211,
            .4
        );
}

.logo-sub {

    margin-top: 5px;

    font-size: 14px;

    letter-spacing: 5px;

    color: #92738e;
}

.star-logo {

    font-size: 35px;

    color: #ffd34d;

    display: inline-block;

    margin-left: 5px;

    animation:
        starSpin 4s linear infinite;
}

@keyframes starSpin {

    from {

        transform:
            rotate(0);
    }

    to {

        transform:
            rotate(360deg);
    }

}

.opening-description {

    margin-top: 35px;

    color: #876f84;

    line-height: 1.8;

    font-size: 14px;
}

.start-button {

    margin-top: 40px;

    padding:
        16px 65px;

    border-radius: 50px;

    background:
        linear-gradient(
            135deg,
            #ff91ce,
            #e879ba
        );

    color: white;

    font-weight: 800;

    font-size: 17px;

    letter-spacing: 2px;

    box-shadow:
        0 8px 25px
        rgba(
            222,
            116,
            182,
            .35
        );

    transition: .25s;
}

.start-button:hover {

    transform:
        translateY(-4px)
        scale(1.03);
}

.start-button:active {

    transform:
        scale(.96);
}


/* =========================================================
   공통 헤더
========================================================= */

.page-header {

    position: absolute;

    top: 0;
    left: 0;

    width: 100%;

    height: 75px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding:
        0 30px;

    z-index: 50;

    background:
        rgba(
            255,
            255,
            255,
            .65
        );

    backdrop-filter:
        blur(10px);

    border-bottom:
        1px solid
        rgba(
            219,
            164,
            205,
            .3
        );
}

.header-title {

    font-weight: 900;

    color: #d47ab2;

    letter-spacing: 2px;
}

.header-step {

    font-size: 12px;

    color: #aa91a7;
}


/* =========================================================
   2. CUSTOMIZE
========================================================= */

#customize {

    flex-direction: column;

    background:
        radial-gradient(
            circle at 30% 30%,
            #fff,
            #fff4fb 50%,
            #f3dceb
        );
}

.customize-container {

    width:
        min(
            1200px,
            94%
        );

    margin: auto;

    padding-top: 95px;

    padding-bottom: 35px;

    display: grid;

    grid-template-columns:
        minmax(
            280px,
            1fr
        )
        minmax(
            300px,
            1fr
        );

    gap: 40px;

    align-items: center;
}


/* =========================================================
   캐릭터 영역
========================================================= */

.character-area {

    min-height: 620px;

    display: flex;

    justify-content: center;

    align-items: center;

    position: relative;

    background:
        radial-gradient(
            ellipse,
            rgba(
                255,
                255,
                255,
                .95
            ),
            rgba(
                255,
                238,
                249,
                .6
            )
        );

    border-radius: 40px;

    border:
        1px solid
        rgba(
            214,
            150,
            197,
            .25
        );

    box-shadow:
        inset 0 0 50px
        rgba(
            255,
            255,
            255,
            .7
        ),
        0 15px 40px
        rgba(
            194,
            130,
            178,
            .08
        );
}

.character-platform {

    position: absolute;

    bottom: 35px;

    width: 210px;

    height: 28px;

    border-radius: 50%;

    background:
        rgba(
            213,
            146,
            195,
            .2
        );

    filter: blur(3px);
}


/* =========================================================
   캐릭터 본체
========================================================= */

.character {

    width: 210px;

    height: 500px;

    position: relative;

    transform-origin:
        center bottom;

    animation:
        characterIdle
        4s ease-in-out infinite;
}

@keyframes characterIdle {

    0%,
    100% {

        transform:
            translateY(0);
    }

    50% {

        transform:
            translateY(-6px);
    }

}


/* =========================================================
   헤어 백
========================================================= */

.hair-back {

    position: absolute;

    width: 175px;

    height: 245px;

    left: 17px;

    top: 20px;

    background:
        var(--hair);

    border-radius:
        48%
        48%
        35%
        35%;

    z-index: 1;

    transition: .4s;
}


/* =========================================================
   귀
========================================================= */

.character-head::before,
.character-head::after {

    content: "";

    position: absolute;

    width: 22px;

    height: 40px;

    background:
        var(--skin);

    top: 65px;

    border-radius: 50%;

    z-index: -1;
}

.character-head::before {

    left: -12px;
}

.character-head::after {

    right: -12px;
}


/* =========================================================
   머리
========================================================= */

.character-head {

    position: absolute;

    width: 150px;

    height: 175px;

    left: 30px;

    top: 55px;

    background:
        var(--skin);

    border-radius:
        48%
        48%
        45%
        45%;

    z-index: 5;

    border:
        1px solid
        rgba(
            150,
            90,
            70,
            .1
        );
}


/* =========================================================
   목
========================================================= */

.character-neck {

    position: absolute;

    top: 205px;

    left: 82px;

    width: 45px;

    height: 50px;

    background:
        var(--skin);

    border-radius:
        0 0 15px 15px;

    z-index: 3;
}


/* =========================================================
   몸
========================================================= */

.character-body {

    position: absolute;

    top: 235px;

    left: 45px;

    width: 120px;

    height: 155px;

    background:
        linear-gradient(
            135deg,
            #f3a2cc,
            #e779b7
        );

    border-radius:
        45px 45px
        20px 20px;

    z-index: 4;

    transition: .4s;
}


/* =========================================================
   치마
========================================================= */

.character-skirt {

    position: absolute;

    top: 350px;

    left: 32px;

    width: 150px;

    height: 90px;

    background:
        linear-gradient(
            135deg,
            #f8badb,
            #ed84bd
        );

    clip-path:
        polygon(
            20% 0,
            80% 0,
            100% 100%,
            0 100%
        );

    z-index: 4;

    transition: .4s;
}


/* =========================================================
   다리
========================================================= */

.character-leg {

    position: absolute;

    top: 425px;

    width: 32px;

    height: 65px;

    background:
        var(--skin);

    border-radius:
        10px 10px
        15px 15px;

    z-index: 2;
}

.character-leg.left {

    left: 68px;
}

.character-leg.right {

    right: 68px;
}


/* =========================================================
   신발
========================================================= */

.character-shoe {

    position: absolute;

    top: 475px;

    width: 52px;

    height: 25px;

    background:
        #e783b9;

    border-radius:
        15px 20px
        10px 10px;

    z-index: 3;

    transition: .3s;
}

.character-shoe.left {

    left: 52px;
}

.character-shoe.right {

    right: 52px;
}


/* =========================================================
   눈
   ★ 중요: 눈은 character-head 안에 있으므로
   머리 기준 좌표를 사용
========================================================= */

.eye {

    position: absolute;

    top: 60px;

    width: 25px;

    height: 32px;

    background: white;

    border-radius: 50%;

    z-index: 10;

    border:
        2px solid
        rgba(
            100,
            60,
            80,
            .15
        );

    transition: .3s;
}

.eye::after {

    content: "";

    position: absolute;

    width: 12px;

    height: 17px;

    left: 50%;

    top: 6px;

    transform:
        translateX(-50%);

    border-radius: 50%;

    background:
        var(--eye-color);

    box-shadow:
        inset 2px 2px 0
        rgba(
            255,
            255,
            255,
            .7
        );
}

.eye.left {

    left: 42px;
}

.eye.right {

    right: 42px;
}


/* =========================================================
   눈 모양
========================================================= */

.eyes-round .eye {

    height: 34px;
}

.eyes-slim .eye {

    height: 18px;

    top: 68px;

    border-radius:
        50%
        50%
        40%
        40%;
}

.eyes-droopy .eye {

    height: 27px;

    top: 65px;

    transform:
        rotate(5deg);
}

.eyes-sharp .eye {

    height: 25px;

    top: 64px;

    transform:
        rotate(-7deg);

    border-radius:
        40%
        60%
        50%
        50%;
}

.eyes-happy .eye {

    height: 14px;

    top: 73px;

    background: transparent;

    border:
        3px solid
        var(--eye-color);

    border-bottom: 0;

    border-left-color:
        transparent;

    border-right-color:
        transparent;

    border-radius: 50%;
}

.eyes-happy .eye::after {

    display: none;
}


/* =========================================================
   코
========================================================= */

.nose {

    position: absolute;

    left: 50%;

    top: 100px;

    transform:
        translateX(-50%);

    width: 9px;

    height: 7px;

    border-left:
        2px solid
        rgba(
            170,
            100,
            95,
            .45
        );

    border-bottom:
        2px solid
        rgba(
            170,
            100,
            95,
            .45
        );

    border-radius:
        0 0 0 6px;

    z-index: 10;
}


/* =========================================================
   입
   ★ 머리 기준 위치로 수정
========================================================= */

.mouth {

    position: absolute;

    left: 50%;

    top: 114px;

    transform:
        translateX(-50%);

    z-index: 11;

    transition: .3s;
}

.mouth-smile {

    width: 30px;

    height: 15px;

    border-bottom:
        3px solid
        #c76583;

    border-radius:
        0 0 50% 50%;
}

.mouth-small {

    width: 15px;

    height: 8px;

    border-bottom:
        3px solid
        #c76583;

    border-radius: 50%;
}

.mouth-open {

    width: 23px;

    height: 17px;

    background:
        #b95d79;

    border-radius: 50%;
}

.mouth-surprised {

    width: 18px;

    height: 22px;

    background:
        #bd6982;

    border-radius: 50%;
}

.mouth-neutral {

    width: 25px;

    height: 5px;

    border-bottom:
        2px solid
        #b96883;
}


/* =========================================================
   앞머리
   ★ 눈보다 위에 위치하도록 수정
========================================================= */

.hair-front {

    position: absolute;

    width: 165px;

    height: 70px;

    left: 22px;

    top: 25px;

    background:
        var(--hair);

    border-radius:
        55%
        55%
        20%
        20%;

    z-index: 7;

    transition: .4s;

    pointer-events: none;
}


/* 앞머리 끝 */

.hair-front::after {

    content: "";

    position: absolute;

    left: 55px;

    bottom: -15px;

    width: 55px;

    height: 30px;

    background:
        var(--hair);

    clip-path:
        polygon(
            0 0,
            100% 0,
            50% 100%
        );
}


/* =========================================================
   헤어 스타일
========================================================= */

.hair-long .hair-back {

    height: 300px;
}

.hair-long .hair-front {

    height: 70px;
}

.hair-bob .hair-back {

    height: 200px;
}

.hair-bob .hair-front {

    height: 72px;
}

.hair-wave .hair-back {

    height: 285px;

    border-radius:
        45%
        45%
        25%
        35%;
}

.hair-wave .hair-front {

    height: 70px;

    border-radius:
        50%
        50%
        25%
        25%;
}

.hair-ponytail .hair-back::after {

    content: "";

    position: absolute;

    width: 70px;

    height: 150px;

    background:
        var(--hair);

    right: -45px;

    top: 45px;

    border-radius: 50%;
}

.hair-twin .hair-back::before,
.hair-twin .hair-back::after {

    content: "";

    position: absolute;

    width: 65px;

    height: 150px;

    background:
        var(--hair);

    top: 25px;

    border-radius: 50%;
}

.hair-twin .hair-back::before {

    left: -42px;
}

.hair-twin .hair-back::after {

    right: -42px;
}


/* =========================================================
   커스터마이징 패널
========================================================= */

.custom-panel {

    background:
        rgba(
            255,
            255,
            255,
            .78
        );

    backdrop-filter:
        blur(15px);

    border:
        1px solid
        rgba(
            210,
            155,
            198,
            .3
        );

    border-radius: 30px;

    padding: 25px;

    box-shadow:
        0 15px 40px
        rgba(
            150,
            100,
            140,
            .1
        );
}

.panel-title {

    font-size: 24px;

    font-weight: 900;

    color: #c76aa9;

    margin-bottom: 5px;
}

.panel-subtitle {

    font-size: 12px;

    color: #a18b9d;

    margin-bottom: 22px;
}

.option-group {

    margin-bottom: 18px;
}

.option-title {

    font-size: 13px;

    font-weight: 800;

    margin-bottom: 9px;

    color: #765c72;
}

.options {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;
}

.option-button {

    padding:
        8px 12px;

    background: #fff;

    border:
        1px solid
        #ead8e7;

    border-radius: 12px;

    color: #806b7d;

    font-size: 12px;

    transition: .2s;
}

.option-button:hover {

    transform:
        translateY(-2px);

    border-color:
        #df8ec3;
}

.option-button.selected {

    background:
        linear-gradient(
            135deg,
            #ff9ed1,
            #e983ba
        );

    color: white;

    border-color:
        transparent;

    box-shadow:
        0 4px 10px
        rgba(
            221,
            125,
            181,
            .25
        );
}


/* 색상 버튼 */

.color-button {

    width: 32px;

    height: 32px;

    border-radius: 50%;

    border:
        3px solid white;

    box-shadow:
        0 0 0 1px
        #dfd1dc;

    transition: .2s;
}

.color-button.selected {

    box-shadow:
        0 0 0 2px
        #db78b4,
        0 0 0 5px
        white;
}


/* 완료 버튼 */

.custom-next {

    width: 100%;

    margin-top: 5px;

    padding: 14px;

    border-radius: 15px;

    background:
        linear-gradient(
            135deg,
            #ff92ca,
            #df73b1
        );

    color: white;

    font-weight: 900;

    font-size: 15px;

    letter-spacing: 1px;

    box-shadow:
        0 8px 18px
        rgba(
            216,
            113,
            175,
            .25
        );

    transition: .2s;
}

.custom-next:hover {

    transform:
        translateY(-2px);
}


/* =========================================================
   3. CARD SELECT
========================================================= */

#cards {

    flex-direction: column;

    background:
        radial-gradient(
            circle at 50% 20%,
            #fff,
            #fff3fb 55%,
            #f4ddeb
        );
}

.cards-container {

    width:
        min(
            1150px,
            94%
        );

    margin: auto;

    padding-top: 100px;

    padding-bottom: 40px;
}

.cards-heading {

    text-align: center;

    margin-bottom: 25px;
}

.cards-heading h1 {

    font-size: 30px;

    color: #c66eaa;
}

.cards-heading p {

    margin-top: 7px;

    color: #9b8497;

    font-size: 13px;
}

.card-tabs {

    display: flex;

    justify-content: center;

    gap: 8px;

    flex-wrap: wrap;

    margin-bottom: 25px;
}

.card-tab {

    padding:
        9px 18px;

    border-radius: 30px;

    background: white;

    border:
        1px solid
        #ead9e7;

    color: #886e82;

    font-size: 12px;

    transition: .2s;
}

.card-tab.active {

    background:
        #e989bd;

    color: white;

    border-color:
        transparent;
}

.card-grid {

    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(
                150px,
                1fr
            )
        );

    gap: 18px;

    max-height: 480px;

    overflow-y: auto;

    padding: 8px;
}

.fashion-card {

    min-height: 220px;

    background: white;

    border-radius: 18px;

    padding: 10px;

    border:
        2px solid
        transparent;

    box-shadow:
        0 7px 20px
        rgba(
            150,
            100,
            140,
            .1
        );

    cursor: pointer;

    transition: .25s;

    position: relative;

    overflow: hidden;
}

.fashion-card:hover {

    transform:
        translateY(-5px)
        rotate(-1deg);

    box-shadow:
        0 12px 25px
        rgba(
            150,
            100,
            140,
            .16
        );
}

.fashion-card.selected {

    border-color:
        #ed82bd;

    box-shadow:
        0 0 0 4px
        rgba(
            237,
            130,
            189,
            .15
        ),
        0 12px 25px
        rgba(
            150,
            100,
            140,
            .16
        );
}

.card-art {

    height: 160px;

    border-radius: 12px;

    display: flex;

    align-items: center;

    justify-content: center;

    position: relative;

    overflow: hidden;

    background:
        linear-gradient(
            135deg,
            #fff5fb,
            #f7dcec
        );
}

.card-clothing {

    position: relative;

    transition: .3s;
}

.top-art {

    width: 70px;

    height: 80px;

    background:
        linear-gradient(
            135deg,
            #ff9fcf,
            #df6faf
        );

    border-radius:
        25px 25px
        15px 15px;
}

.top-art::before,
.top-art::after {

    content: "";

    position: absolute;

    width: 25px;

    height: 55px;

    background:
        inherit;

    top: 5px;

    border-radius: 15px;
}

.top-art::before {

    left: -17px;

    transform:
        rotate(20deg);
}

.top-art::after {

    right: -17px;

    transform:
        rotate(-20deg);
}

.skirt-art {

    width: 100px;

    height: 75px;

    background:
        linear-gradient(
            135deg,
            #f7a9d0,
            #c879ba
        );

    clip-path:
